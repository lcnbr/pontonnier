// The gallery controls are HTML generated by Typst; JavaScript enhances the photos.
#let viewer-icon(name) = {
  let paths = (
    close: "M6 6l12 12M6 18L18 6",
    previous: "M15 6l-6 6 6 6",
    next: "M9 6l6 6-6 6",
    zoom-in: "M7 10.5h7M10.5 7v7M16 16l5 5",
    zoom-out: "M7 10.5h7M16 16l5 5",
  )
  html.elem("svg", attrs: (xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24",
    width: "20", height: "20", fill: "none", stroke: "currentColor",
    "stroke-width": "1.6", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true"))[
    #if name.starts-with("zoom-") { html.elem("circle", attrs: (cx: "10.5", cy: "10.5", r: "7.5")) }
    #html.elem("path", attrs: (d: paths.at(name)))
  ]
}
#let viewer-button(class, label, icon) = html.button(type: "button", class: class,
  title: label, ..("aria-label": label), viewer-icon(icon))
#let photo-viewer() = html.section(class: "photo-viewer", hidden: true,
  ..("aria-label": "Visionneuse de photos"))[
  #html.div(class: "pg-viewer-bar")[
    #html.p(class: "pg-viewer-count", ..("aria-live": "polite"))[]
    #html.div(class: "pg-viewer-tools")[
      #viewer-button("pg-zoom-out", "Réduire", "zoom-out")
      #html.button(type: "button", class: "pg-zoom-reset", title: "Afficher la photo entière",
        ..("aria-label": "Afficher la photo entière"))[100%]
      #viewer-button("pg-zoom-in", "Agrandir", "zoom-in")
      #viewer-button("pg-viewer-close", "Fermer", "close")
    ]
  ]
  #html.div(class: "pg-viewer-stage")[
    #html.div(class: "pg-image-viewport")[]
    #viewer-button("pg-photo-nav pg-photo-prev", "Photo précédente", "previous")
    #viewer-button("pg-photo-nav pg-photo-next", "Photo suivante", "next")
  ]
  #html.div(class: "pg-viewer-caption", hidden: true)[]
]
